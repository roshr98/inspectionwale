{
  "rootDirectory": "website",
  "trailingSlash": false,
  "redirects": [
    { "source": "/Home",              "destination": "/",                "permanent": true },
    { "source": "/Used-Car-Marketplace",  "destination": "/car-marketplace/", "permanent": true },
    { "source": "/Used-Car-Marketplace/", "destination": "/car-marketplace/", "permanent": true },
    { "source": "/car-marketplace",       "destination": "/car-marketplace/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/car-value",        "destination": "https://565pfipvrdzny5ftic5htroshu0lltuf.lambda-url.us-east-1.on.aws/" },
    { "source": "/api/quote",            "destination": "https://dnocsuec6aeok3oykcujglp2hq0bocso.lambda-url.us-east-1.on.aws/" },
    { "source": "/api/customer-listings","destination": "https://423cmvhw3g.execute-api.us-east-1.amazonaws.com/prod/customer-listings" },
    { "source": "/api/reviews",          "destination": "https://cznea7cetynoa5eqim53crc2xq0scqec.lambda-url.us-east-1.on.aws/" },
    { "source": "/api/ads",              "destination": "https://e5c4zwzl3vvb5t6fq3djkuhvjm0omhdm.lambda-url.us-east-1.on.aws/" },
    { "source": "/api/listing-comments", "destination": "https://PLACEHOLDER_LISTING_COMMENTS_LAMBDA_URL.lambda-url.us-east-1.on.aws/" },
    { "source": "/admin",                "destination": "/admin/index.html" },
    { "source": "/admin/",               "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" }
      ]
    },
    {
      "source": "/(.*\\.(?:css|gif|ico|jpg|jpeg|js|png|txt|svg|woff|woff2|ttf|map|json|webp|xml|pdf|webmanifest|avif))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}